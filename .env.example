# Doctor On Call — Environment Variables Template

# -------------------------------------------------------------
# Option A: PostgreSQL (Recommended for Vercel: Neon / Supabase / Vercel Postgres)
# -------------------------------------------------------------
# POSTGRES_URL="postgres://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL="postgres://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# -------------------------------------------------------------
# Option B: Turso / LibSQL (Cloud SQLite)
# -------------------------------------------------------------
# TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# -------------------------------------------------------------
# Option C: Local Development Fallback
# -------------------------------------------------------------
# Leave all variables blank/commented out to use built-in local SQLite (clinic.db)
PORT=3000
